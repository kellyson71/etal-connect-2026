{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'sem dependências de Node'",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "publico",
  "functions": {
    "api/index.py": { "includeFiles": "backend/{app,seed}/**", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/q/(.*)", "destination": "/api/index" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/homologacao", "destination": "/homologacao.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
