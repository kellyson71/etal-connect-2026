# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Temporary standalone export build
/.html-export-work/

# Protótipo local
/prototipo/.venv/
/prototipo/__pycache__/
/prototipo/server.log
__pycache__/
*.pyc

# Estado local de ferramentas e da hospedagem original
/tmp/
/.openai/

# backend
backend/.venv/
backend/*.db
deploy/.env
!deploy/.env.example
.pytest_cache/

# Vercel
/publico/
.vercel

# PDF da apresentação: gerado com npm run docs:pdf (grande demais para versionar)
/docs/ETAL-Connect-documentacao.pdf

# Gerado a partir de mapa3d/ por npm run pwa
prototipo/mapa3d/

# PNGs originais da comparação dos mapas (75 MB): ficam só na máquina; hashes em evidencias.json
/docs/comparacao-modelos/imagens/
/docs/comparacao-modelos/*.zip

# certificados locais do modo HTTPS do protótipo
/prototipo/.certs/
