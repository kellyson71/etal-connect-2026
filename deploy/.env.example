# Copie para .env e preencha. Nunca coloque o .env no Git.
DOMINIO=etal.nadic.ifrn.edu.br
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Segredo das sessões e dos QR codes (gere com: python3 -c "import secrets;print(secrets.token_urlsafe(48))").
# Trocar o segredo invalida todos os QRs impressos.
ETAL_SEGREDO=

# OAuth2 do SUAP (registro feito pela TI do IFRN). Redirecionamento: https://DOMINIO/api/auth/suap/retorno
ETAL_SUAP_CLIENT_ID=
ETAL_SUAP_CLIENT_SECRET=

# Quem acessa o painel da organização: matrículas ou e-mails, separados por vírgula.
ETAL_ORGANIZACAO=

# E-mail do link de entrada dos visitantes.
ETAL_SMTP_HOST=
ETAL_SMTP_PORTA=587
ETAL_SMTP_USUARIO=
ETAL_SMTP_SENHA=
ETAL_SMTP_REMETENTE=

# Presença: aceitar o QR de uma atividade só de 20 min antes até o fim dela.
ETAL_JANELA_PRESENCA=true
ETAL_ANTECEDENCIA_MIN=20
