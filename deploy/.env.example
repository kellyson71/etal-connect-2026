# Copie para .env, na mesma pasta do docker-compose.yml, e preencha. Nunca coloque o .env no Git.
DOMINIO=etal.nadic.ifrn.edu.br
# Porta do servidor onde o app fica; o proxy do domínio encaminha para ela (http://127.0.0.1:PORTA).
PORTA=8080
# Quem pode chegar nessa porta: 127.0.0.1 = só o proxy da própria máquina (recomendado); 0.0.0.0 = qualquer um.
ENDERECO=127.0.0.1
# Só letras, números, - e _ (a senha entra no endereço de conexão do banco). Gere com o comando do ETAL_SEGREDO.
POSTGRES_PASSWORD=

# Versão das imagens: latest acompanha a main. Para voltar a uma versão anterior, use o hash do commit
# (a lista está em Packages, no GitHub) e rode docker compose up -d.
VERSAO=latest

# Segredo das sessões e dos QR codes (gere com: python3 -c "import secrets;print(secrets.token_urlsafe(48))").
# Trocar o segredo invalida todos os QRs impressos.
ETAL_SEGREDO=

# Aplicação OAuth2 do SUAP (a autorização já existe). No SUAP, o retorno tem que ser https://DOMINIO/api/auth/suap/retorno
ETAL_SUAP_CLIENT_ID=
ETAL_SUAP_CLIENT_SECRET=
# Página pública de inscrição do evento no SUAP: vagas reais e inscrições de cada pessoa (vazio desliga)
ETAL_SUAP_INSCRICOES_URL=https://suap.ifrn.edu.br/eventos/inscricao/1/10301/

# Quem acessa o painel da organização: matrículas ou e-mails, separados por vírgula.
ETAL_ORGANIZACAO=

# E-mail do link de entrada dos visitantes.
ETAL_SMTP_HOST=
ETAL_SMTP_PORTA=587
ETAL_SMTP_USUARIO=
ETAL_SMTP_SENHA=
ETAL_SMTP_REMETENTE=

# Presença: aceitar o QR de uma atividade só de 20 min antes até o fim dela.
ETAL_JANELA_PRESENCA=true
ETAL_ANTECEDENCIA_MIN=20
