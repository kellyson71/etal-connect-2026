# Servidor do app (imagem web): entrega o PWA e encaminha /api e /q para a API.
# Por padrão escuta HTTP na porta 80 do contêiner e fica atrás do proxy do servidor (nginx ou Apache), que cuida do
# HTTPS, como os outros sistemas do NADIC. Com SITE=etal.nadic.ifrn.edu.br, o próprio Caddy pede o certificado; aí as
# portas 80 e 443 do servidor precisam ser dele (deploy/docker-compose.https.yml).
{
	servers {
		# O proxy do servidor chega por uma rede privada (a do Docker): mantém o IP real de quem acessa e o https
		# informado por ele. Sem isso, todo mundo pareceria vir do mesmo endereço e os limites por rede somariam todos.
		trusted_proxies static private_ranges
	}
}

{$SITE::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(self)"
		-Server
	}
	@api path /api/* /q/*
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	rewrite /homologacao /homologacao.html
	# Em produção o app fala com a API na mesma origem.
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond "window.ETAL_CONFIG = { api: '' }; document.documentElement.classList.add('prod');" 200
	}
	# O app (PWA). O service worker não pode ficar em cache longo.
	handle {
		root * /srv/app
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
