              },
              "type": "array",
              "title": "Detail"
            }
          },
          "type": "object",
          "title": "HTTPValidationError"
        },
        "Leitura": {
          "properties": {
            "qr": {
              "type": "string",
              "maxLength": 600,
              "minLength": 8,
              "title": "Qr"
            }
          },
          "type": "object",
          "required": [
            "qr"
          ],
          "title": "Leitura"
        },
        "LoginSuap": {
          "properties": {
            "matricula": {
              "type": "string",
              "maxLength": 40,
              "minLength": 3,
              "title": "Matricula"
            },
            "senha": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1,
              "title": "Senha"
            }
          },
          "type": "object",
          "required": [
            "matricula",
            "senha"
          ],
          "title": "LoginSuap"
        },
        "NovoAviso": {
          "properties": {
            "titulo": {
              "type": "string",
              "maxLength": 140,
              "minLength": 2,
              "title": "Titulo"
            },
            "texto": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 2,
              "title": "Texto"
            },
            "atividade": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Atividade"
            }
          },
          "type": "object",
          "required": [
            "titulo",
            "texto"
          ],
          "title": "NovoAviso"
        },
        "TrocaSala": {
          "properties": {
            "andar": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Andar"
            },
            "zona": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Zona"
            },
            "sala": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1,
              "title": "Sala"
            },
            "avisar": {
              "type": "boolean",
              "title": "Avisar",
              "default": true
            }
          },
          "type": "object",
          "required": [
            "sala"
          ],
          "title": "TrocaSala"
        },
        "ValidationError": {
          "properties": {
            "loc": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array",
              "title": "Location"
            },
            "msg": {
              "type": "string",
              "title": "Message"
            },
            "type": {
              "type": "string",
              "title": "Error Type"
            },
            "input": {
              "title": "Input"
            },
            "ctx": {
              "type": "object",
              "title": "Context"
            }
          },
          "type": "object",
          "required": [
            "loc",
            "msg",
            "type"
          ],
          "title": "ValidationError"
        },
        "Visitante": {
          "properties": {
            "nome": {
              "type": "string",
              "maxLength": 200,
              "minLength": 2,
              "title": "Nome"
            },
            "email": {
              "type": "string",
              "format": "email",
              "title": "Email"
            },
            "instituicao": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Instituicao"
            },
            "cidade": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cidade"
            }
          },
          "type": "object",
          "required": [
            "nome",
            "email"
          ],
          "title": "Visitante"
        }
      }
    }
